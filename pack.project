import cmake

withProtobuf = cmake.Option("WITH_PROTOBUF", False)
withQt = cmake.Option("WITH_QT", False)

if withProtobuf.isSet():
    import sys
    sys.path.append(cmake.Config.currentPath()+"/protoc/cmake")
    import protogen

pack = cmake.SharedLib(
    "pack",
    sources = [
        "pack/types/string.h",
        "pack/types/list.h",
        "pack/types/map.h",
        "pack/types/value.h",
        "pack/types/enum.h",
        "pack/types/node.h",
        "pack/types/binary.h",

        "pack/pack.h",
        "pack/attribute.h",
        "pack/options.h",
        "pack/types.h",
        "pack/convert.h",
        "pack/utils.h",
        "pack/magic-enum.h",
        "pack/ustring.h",
        "pack/flags.h",
        "pack/meta.h",
        "pack/serialization.h",
        "pack/visitor.h",

        "src/types/enum.cpp",
        "src/types/node.cpp",
        "src/types/binary.cpp",
        "src/types/map.cpp",
        "src/types/list.cpp",
        "src/types/value.cpp",
        "src/types/string.cpp",

        "src/attribute.cpp",
        "src/ustring.cpp",
        "src/types.cpp",
        "src/serialization.cpp",
        "src/providers/json.cpp",
        "src/providers/json.h",
        "src/providers/yaml.cpp",
        "src/providers/yaml.h",
    ],
    dependencies = [
        cmake.Dependency("yaml-cpp"),
        cmake.Dependency("nlohmann_json::nlohmann_json"),
        cmake.Dependency("tl-expected", public = True, targetName = "tl::expected"),
    ],
    flags = [
        "-fsanitize=address",
        "-fsanitize=undefined",
        "-fsanitize=leak",
    ]
)

if withProtobuf.isSet():
    pack.sources.extend([
        "src/providers/protobuf.cpp",
        "src/providers/protobuf.h",
    ])
    pack.dependencies.append(
        cmake.Dependency("Protobuf", targetName = "protobuf::libprotobuf"),
    )

    protoc = cmake.Executable(
        "protoc-gen-pack",
        sources = [
            "protoc/main.cpp",
            "protoc/generator.h",
            "protoc/generator.cpp",
            "protoc/filegenerator.h",
            "protoc/filegenerator.cpp",
            "protoc/classgenerator.h",
            "protoc/classgenerator.cpp",
            "protoc/formatter.h",
            "protoc/utils.h",
            "protoc/cmake/protogen.cmake",
            "protoc/cmake/protogen.py"
        ],
        dependencies = [
            cmake.Dependency("Protobuf", targetName = "protobuf::libprotobuf"),
            cmake.Dependency("libprotoc", targetName = "protobuf::libprotoc"),
        ],
        options = [
            "PROTOBUF_USE_DLLS"
        ]
    )

if withQt.isSet():
    pack.dependencies.append("Qt6::Core")
    pack.definitions.append("WITH_QT")
    pack.definitions.append(cmake.Definition.Qt.NoCastFromAscii())
    pack.definitions.append(cmake.Definition.Qt.NoCastToAscii())
else:
    pack.dependencies.append("utf8cpp")

if cmake.Config.buildTesting:
    test = pack.addTest([
        "tests/catch2.h",
        "tests/ustring.cpp",
        "tests/types.cpp",
        "tests/convert.cpp",
        "tests/value.cpp",
        "tests/list.cpp",
        "tests/node.cpp",
        "tests/map.cpp",
        "tests/enums.cpp",
        "tests/binary.cpp",

        "tests/serialize/value.cpp",
        "tests/serialize/node.cpp",
    ])
    if withProtobuf.isSet():
        test.sources.extend([
            "tests/protobuf/example.proto",
            "tests/protobuf/item.cpp"
        ])

        protogen.generate(test,
            "tests/protobuf/example.proto"
        )
